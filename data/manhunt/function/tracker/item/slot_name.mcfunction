# tracker/item/slot_name — turn mh.slot into the slot NAME the item commands need.
#
# The macros take a whole slot string rather than an index, so offhand and inventory
# slots are first-class homes for the tracker instead of special cases.

execute if score @s mh.slot matches 0 run data modify storage manhunt:tmp wargs.slot set value "hotbar.0"
execute if score @s mh.slot matches 1 run data modify storage manhunt:tmp wargs.slot set value "hotbar.1"
