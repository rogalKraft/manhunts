{
  "type": "minecraft:confirmation",
  "title": {
    "translate": "manhunt.ui.ask.full",
    "fallback": "Full reset?"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "translate": "manhunt.ui.ask.full.body",
        "fallback": "Clears the match AND every role.",
        "color": "gray"
      }
    }
  ],
  "yes": {
    "label": {
      "translate": "manhunt.ui.fullreset",
      "fallback": "Full reset",
      "color": "red"
    },
    "action": {
      "type": "minecraft:run_command",
      "command": "function manhunt:admin/action/full_reset"
    }
  },
  "no": {
    "label": {
      "translate": "manhunt.ui.cancel",
      "fallback": "Cancel"
    }
  }
}
