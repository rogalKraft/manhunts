{
  "type": "minecraft:confirmation",
  "title": {
    "translate": "manhunt.ui.ask.forceend",
    "fallback": "End the match?"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "translate": "manhunt.ui.ask.forceend.body",
        "fallback": "The match ends with no winner.",
        "color": "gray"
      }
    }
  ],
  "yes": {
    "label": {
      "translate": "manhunt.ui.forceend",
      "fallback": "Force end",
      "color": "red"
    },
    "action": {
      "type": "minecraft:run_command",
      "command": "function manhunt:admin/action/force_end"
    }
  },
  "no": {
    "label": {
      "translate": "manhunt.ui.cancel",
      "fallback": "Cancel"
    }
  }
}
